# Discord AI 面接ボット - 環境変数設定

# Discord Bot Token
# Discord Developer Portal で取得: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Groq API Key
# Groq Console で取得（無料）: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Discord Category ID（オプション）
# 面接チャンネルを自動作成するカテゴリの ID
# 設定しない場合は 0 のまま
INTERVIEW_CATEGORY_ID=0
